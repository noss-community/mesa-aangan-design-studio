# --- Database (Neon) ---
# Postgres connection string from your Neon project (pooled connection is fine).
DATABASE_URL=postgres://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/aangan?sslmode=require

# --- Qualification engine (Gemini) ---
GEMINI_API_KEY=
# Optional override, defaults to a fast/cheap Gemini model.
GEMINI_MODEL=gemini-2.5-flash

# --- Voice layer (Vaani) ---
# REST API key, used by our code (and scripts/setup-vaani-agent.ts) to call api.vaanivoice.ai.
VAANI_API_KEY=
# The agent created by `npm run vaani:sync` (native Vaani agent — its own LLM holds the live
# conversation; see README "Architecture" for why this isn't a BYOL/live-Gemini setup).
VAANI_AGENT_ID=
# Vaani's webhook registration (dashboard-only, Settings -> Webhooks) doesn't sign requests, so
# this is appended as a query param on the URL registered there: .../api/webhook/vaani?key=...
VAANI_WEBHOOK_SECRET=change-me

# --- Booking (Cal.com) ---
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
# Cal.com v2 API version header for bookings/event-types specifically. The /slots endpoint needs a
# different version (2024-09-04) — that one's hardcoded in lib/calcom.ts, not configurable here,
# since it's a fixed Cal.com API quirk rather than something that should vary by deployment.
CALCOM_API_VERSION=2024-08-13
CALCOM_TIMEZONE=Asia/Kolkata

# --- CRM (HubSpot) ---
HUBSPOT_ACCESS_TOKEN=
# Internal ID of the pipeline stage to move a deal into once a call qualifies.
# Find this under HubSpot Settings -> Deals -> Pipelines -> (your pipeline) -> stage internal ID.
HUBSPOT_DEAL_STAGE_ID=
# Optional: only needed if you use a non-default pipeline.
HUBSPOT_PIPELINE_ID=

# --- Economics panel rates ---
# These three defaults match the spec (12, 300, 1100000). They can be overridden two ways:
#  1) Plain env vars below - simplest, but Vercel requires a redeploy for changes to apply.
#  2) A linked Vercel Edge Config store (see README "Live-editable rates") - changes apply on the
#     next dashboard refresh, no redeploy needed. If EDGE_CONFIG is set and has these keys, it wins.
VAANI_LABS_RATE_PER_MIN=12
GEMINI_API_RATE_PER_MILLION=300
AVERAGE_PROJECT_VALUE_INR=1100000

# Populated automatically by Vercel when you link an Edge Config store to this project.
EDGE_CONFIG=
